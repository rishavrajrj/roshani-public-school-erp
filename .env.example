# Roshani Public School ERP — Environment Variables
# Copy this file to .env.local and fill in values.

# Supabase ERP Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase ERP Anon Key (public, safe for frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER-ONLY — NEVER expose to client)
# Required for: scripts/create-test-users.ts
# Get from: Supabase Dashboard → Project Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# ENVIRONMENT NOTES
# ============================================================
# Development:
#   - Email confirmation: DISABLED (users can log in immediately)
#   - Test users created via: npx tsx scripts/create-test-users.ts
#
# Production:
#   - Email confirmation: MUST BE ENABLED
#   - Configure SMTP in Supabase Dashboard → Authentication → Email
#   - Users provisioned through admin workflows, not this script
# ============================================================
